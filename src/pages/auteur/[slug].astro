---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import NewNavmenu from "../../components/NewNavmenu.astro";
import BaseHeader from "../../components/BaseHeader.astro";
import BaseFooter from "../../components/BaseFooter.astro";
import BaseScript from "../../components/BaseScript.astro";
import BasePodcastBanner from "../../components/BasePodcastBanner.astro";
import BaseNieuwsItem from "../../components/BaseNieuwsItem.astro";
import { slugFromEntryId, authorSlug, isCollectiveAuthor, buildPublisherSchema } from "../../lib/format";
import { franchiseName } from "../../lib/franchises";

export async function getStaticPaths() {
  const [reviews, nieuws] = await Promise.all([getCollection("reviews"), getCollection("nieuws")]);

  // Get unique named authors (schrijver field) from both collections — not
  // just reviews, so a real nieuws byline (added going forward, see
  // NieuwsLayout.astro) gets a working /auteur/ page instead of a 404. The
  // collective "de Cinematen" byline isn't a real person, so it doesn't get
  // its own author page.
  const authors = new Set<string>();
  [...reviews, ...nieuws].forEach(entry => {
    if (entry.data.schrijver && !isCollectiveAuthor(entry.data.schrijver)) authors.add(entry.data.schrijver);
  });

  return Array.from(authors).map(author => ({
    params: { slug: authorSlug(author) },
    props: { authorName: author },
  }));
}

const { authorName } = Astro.props;
const { slug } = Astro.params;

const reviews = await getCollection("reviews");
const authorReviews = reviews
  .filter(r => r.data.schrijver?.toLowerCase() === authorName.toLowerCase())
  .sort((a, b) => new Date(b.data.date ?? 0).getTime() - new Date(a.data.date ?? 0).getTime());

const canonicalURL = `https://www.cinematen.be/auteur/${slug}/`;

// GEO audit (2026-07-26): Person entity was previously just name+url — the
// thinnest possible entity. knowsAbout is derived from this author's own
// actual tag/franchise data (not a generic hardcoded list), so it's a real
// signal, not filler. sameAs (personal LinkedIn/Letterboxd/X) deliberately
// omitted — don't guess URLs the author hasn't confirmed.
const topicCounts = new Map<string, number>();
authorReviews.forEach((r) => {
  (r.data.tags || []).forEach((t) => topicCounts.set(t, (topicCounts.get(t) || 0) + 1));
  (r.data.franchise || []).forEach((f) => {
    const label = franchiseName(f);
    topicCounts.set(label, (topicCounts.get(label) || 0) + 1);
  });
});
const knowsAbout = [...topicCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6)
  .map(([topic]) => topic);
---

<html lang="nl">
<head>
  <BaseHead
    title={`${authorName} — Reviews op Cinematen.be`}
    description={`Alle reviews en blogs van ${authorName} op Cinematen.be. Film- en seriereviews met sterbeoordeling.`}
    canonicalURL={canonicalURL}
  />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "url": canonicalURL,
    "mainEntity": {
      "@type": "Person",
      "name": authorName,
      "url": canonicalURL,
      "jobTitle": "Filmrecensent",
      "description": `${authorName} schrijft film- en seriereviews voor Cinematen.be.`,
      ...(knowsAbout.length > 0 && { "knowsAbout": knowsAbout }),
      "worksFor": buildPublisherSchema()
    }
  })}></script>
</head>
<body class="body">
  <div class="page-wrapper">
    <NewNavmenu />
    <BaseHeader />
    <div class="content">
      <div class="container">
        <h1 class="nieuws-title">Reviews door {authorName}</h1>
        <p style="color: #a78bfa; margin-bottom: 2rem;">{authorReviews.length} review{authorReviews.length !== 1 ? 's' : ''}</p>
        <div class="w-layout-grid nieuws-list">
          {authorReviews.map(post => (
            <BaseNieuwsItem
              url={`/reviews&blogs/${slugFromEntryId(post.id)}`}
              title={post.data.title}
              thumbnail={post.data.thumbnail || post.data.poster}
              date={post.data.date}
              content={post.data.summary || ""}
            />
          ))}
        </div>
      </div>
      <BasePodcastBanner />
    </div>
    <BaseFooter />
  </div>
  <BaseScript />
</body>
</html>
