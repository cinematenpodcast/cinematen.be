---
// Import necessary components
import ListingShell from "../../../layouts/ListingShell.astro";
import ArticleCard from "../../../components/design-system/ArticleCard.astro";
import ReviewsFilterChips from "../../../components/ReviewsFilterChips.astro";
import PodcastCard from "../../../components/design-system/PodcastCard.astro";
import { getCollection } from "astro:content";
import { extractPreview } from "../../../lib/textPreview";
import { formatCardDate, ratingOutOfTen, slugFromEntryId } from "../../../lib/format";

export async function getStaticPaths () {
  // Get all reviews from content collection
  const allPostsRaw = await getCollection("reviews");
  const allPosts = allPostsRaw.map(post => ({
    url: `/reviews&blogs/${slugFromEntryId(post.id)}`,
    frontmatter: post.data,
    rawContent: () => post.data.summary || extractPreview(post.body),
  }));

  // Build tag map
  const tagMap = new Map();
  allPosts.forEach((post) => {
    if (post.frontmatter.title && post.frontmatter.tags) {
      post.frontmatter.tags.forEach((tag) => {
        const formattedTag = tag.toLowerCase().replace(/:/g, '');
        if (!tagMap.has(formattedTag)) {
          tagMap.set(formattedTag, []);
        }
        tagMap.get(formattedTag).push(post);
      });
    }
  });

  // Return paths for each tag
  return Array.from(tagMap.entries()).map(([tag, posts]) => ({
    params: { tag },
    props: {
      tagname: tag,
      count: posts.length,
      tagged: posts
    }
  }));
}

// grab the selected tag from the url (dynamic [tag])
const tagname = Astro.params.tag.toLowerCase(); // Convert tagname to lowercase
const { tagged } = Astro.props;

// Indexable only with enough posts to not read as thin content (SEO audit,
// 2026-07-22 — see src/pages/nieuws/tags/[tag].astro for the same rule and
// its rationale: tags are now a cleaned, fixed vocabulary, not noisy
// free-text, so blanket noindex no longer makes sense for every tag page).
const MIN_POSTS_TO_INDEX = 3;
const indexable = tagged.length >= MIN_POSTS_TO_INDEX;
const canonicalURL = `https://www.cinematen.be/reviews&blogs/tags/${tagname}/`;
const pageTitle = `${tagname[0].toUpperCase()}${tagname.slice(1)} — Reviews & Blogs | Cinematen.be`;
const pageDescription = `${tagged.length} review${tagged.length !== 1 ? "s" : ""} getagd met "${tagname}" op Cinematen.be.`;
---

<ListingShell
  navActive="reviews"
  useExcludeHead={!indexable}
  title={indexable ? pageTitle : undefined}
  description={indexable ? pageDescription : undefined}
  canonicalURL={indexable ? canonicalURL : undefined}
>
  <div class="cn-listing__inner">
    <h1>Reviews &amp; Blogs — {tagname}</h1>
    <p class="cn-listing__intro">{tagged.length} review{tagged.length !== 1 ? "s" : ""} getagd met &ldquo;{tagname}&rdquo;.</p>
    <ReviewsFilterChips activeTag={tagname} />
    <div class="cn-listing__grid">
      {tagged
        .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
        .map(post => {
          return (
            <ArticleCard title={post.frontmatter.title} href={post.url} excerpt={post.frontmatter.summary ?? post.rawContent()} rating={ratingOutOfTen(post.frontmatter.rating)}>
              <img slot="image" src={post.frontmatter.thumbnail} alt={post.frontmatter.title} loading="lazy" />
              <span slot="meta">
                {formatCardDate(post.frontmatter.date)}
                {post.frontmatter.schrijver ? ` · ${post.frontmatter.schrijver}` : ""}
              </span>
            </ArticleCard>
          );
        })}
    </div>
  </div>
  <div class="cn-listing__podcast">
    <PodcastCard />
  </div>
</ListingShell>
