---
// Franchise index — the single entry point all 9 hub pages were missing.
// Before this page, the hubs had no link from anywhere in the chrome: they
// were reachable only from a spoke article's "Meer over X" link or the sitemap.
import ListingShell from "../../layouts/ListingShell.astro";
import { getCollection } from "astro:content";
import { HUB_ELIGIBLE, franchiseName } from "../../lib/franchises";

const nieuws = (await getCollection("nieuws")).filter((post) => !post.data.draft);
const reviews = await getCollection("reviews");

const hubs = [...HUB_ELIGIBLE]
  .map((slug) => {
    const newsItems = nieuws.filter((p) => (p.data.franchise || []).includes(slug));
    const reviewItems = reviews.filter((p) => (p.data.franchise || []).includes(slug));
    const all = [...newsItems, ...reviewItems];
    const latest = all.sort(
      (a, b) => new Date(b.data.date ?? 0).getTime() - new Date(a.data.date ?? 0).getTime()
    )[0];
    return {
      slug,
      name: franchiseName(slug),
      news: newsItems.length,
      reviews: reviewItems.length,
      total: all.length,
      latest: latest?.data.title ?? null,
    };
  })
  .sort((a, b) => b.total - a.total);

const canonicalURL = "https://www.cinematen.be/franchises/";
---

<ListingShell
  navActive={null}
  useExcludeHead={false}
  title="Franchises | Cinematen.be"
  description="Alle nieuws en recensies per filmwereld: Marvel, DC, Star Wars, Star Trek, Harry Potter, Game of Thrones, Jurassic Park, Lord of the Rings en Stranger Things."
  canonicalURL={canonicalURL}
>
  <div class="cn-listing__inner">
    <h1>Franchises</h1>
    <p class="cn-listing__intro">
      Alles over je favoriete filmwerelden op één plek: het laatste nieuws, de recensies en de
      artikelen per franchise.
    </p>

    <ul class="cn-franchises">
      {
        hubs.map((hub) => (
          <li class="cn-franchises__card">
            <a href={`/franchises/${hub.slug}/`}>
              <span class="cn-franchises__name">{hub.name}</span>
              <span class="cn-franchises__count">
                {hub.news} nieuws · {hub.reviews} review{hub.reviews === 1 ? "" : "s"}
              </span>
              {hub.latest && <span class="cn-franchises__latest">{hub.latest}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</ListingShell>

<style>
  .cn-franchises {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-gutter, 24px);
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
  }
  .cn-franchises__card a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 24px;
    border: 1px solid color-mix(in srgb, var(--on-surface-variant) 30%, transparent);
    border-radius: 12px;
    text-decoration: none;
    background: color-mix(in srgb, var(--on-surface) 4%, transparent);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .cn-franchises__card a:hover {
    border-color: var(--primary, #7aa2ff);
    transform: translateY(-2px);
  }
  .cn-franchises__name {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 22px;
    color: var(--on-surface);
  }
  .cn-franchises__count {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--on-surface-variant);
  }
  .cn-franchises__latest {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.4;
    color: var(--on-surface-variant);
  }
  @media (max-width: 900px) {
    .cn-franchises {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .cn-franchises {
      grid-template-columns: 1fr;
    }
  }
</style>
