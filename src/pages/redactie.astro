---
// Editorial policy / corrections page — the trust page a publisher is expected
// to have (and the target of Organization.publishingPrinciples). Linked from
// the footer on every page, and lists both authors so /auteur/* finally has an
// inbound link.
import ListingShell from "../layouts/ListingShell.astro";

const canonicalURL = "https://www.cinematen.be/redactie/";
const updated = "7 november 2026";
---

<ListingShell
  navActive={null}
  useExcludeHead={false}
  title="Redactie & werkwijze | Cinematen.be"
  description="Wie schrijft er bij Cinematen, hoe komen we aan onze informatie en wat doen we als er iets fout staat? Onze redactionele werkwijze en correctieprocedure."
  canonicalURL={canonicalURL}
>
  <div class="cn-listing__inner">
    <article class="cn-redactie">
      <h1>Redactie &amp; werkwijze</h1>
      <p class="cn-redactie__lead">
        Cinematen.be is een onafhankelijke Nederlandstalige website over film en televisie. Hier
        lees je wie er schrijft, waar onze informatie vandaan komt en wat we doen als er iets niet
        klopt.
      </p>

      <h2>Wie maakt Cinematen?</h2>
      <p>
        Cinematen wordt gemaakt door twee mensen. We schrijven alle artikelen zelf en maken samen de
        <a href="/#podcast">Cinematen-podcast</a>.
      </p>
      <ul>
        <li>
          <a href="/auteur/yorrick/">Yorrick Schoonheydt</a> — nieuws, recensies en de podcast.
        </li>
        <li>
          <a href="/auteur/maarten/">Maarten</a> — recensies en de podcast.
        </li>
      </ul>

      <h2>Nieuws</h2>
      <p>
        Onze nieuwsberichten zijn gebaseerd op berichtgeving van internationale film- en tv-media,
        zoals Variety, The Hollywood Reporter en SlashFilm. Waar we een bron gebruiken, staat die
        onderaan het artikel vermeld en gelinkt. We vatten het nieuws in het Nederlands samen en
        schrijven de tekst zelf — er worden geen artikelen automatisch overgenomen of gegenereerd.
      </p>

      <h2>Recensies</h2>
      <p>
        Een recensie is onze eigen kijkervaring. We beoordelen wat we zelf gezien hebben, geven een
        score op 10 en onderbouwen die in de tekst. Smaak speelt daarbij altijd een rol: een score is
        een mening, geen meting.
      </p>

      <h2>Correcties</h2>
      <p>
        Staat er iets fout, of is een bericht achterhaald? Mail het naar
        <a href="mailto:hello@cinematen.be">hello@cinematen.be</a> met de link naar het artikel en
        wat er niet klopt. We passen het artikel aan en vermelden de correctie wanneer die
        inhoudelijk relevant is. Bij een ingrijpende wijziging tonen we de bijgewerkte datum bij het
        artikel.
      </p>

      <h2>Onafhankelijkheid</h2>
      <p>
        We publiceren geen gesponsorde artikelen en ontvangen geen vergoeding voor het noemen van
        films, series of diensten. Mocht daar in de toekomst iets aan veranderen, dan staat dat
        expliciet en zichtbaar in het betreffende artikel.
      </p>

      <h2>Contact</h2>
      <p>
        Voor vragen, tips of samenwerkingen: <a href="mailto:hello@cinematen.be">hello@cinematen.be</a>
        of via de <a href="/contact/">contactpagina</a>.
      </p>

      <p class="cn-redactie__updated">Laatst bijgewerkt: {updated}</p>
    </article>
  </div>
</ListingShell>

<style>
  .cn-redactie {
    max-width: 760px;
    margin: 0 auto;
    font-family: var(--font-sans);
    color: var(--on-surface);
  }
  .cn-redactie__lead {
    font-size: 19px;
    line-height: 1.6;
    color: var(--on-surface-variant);
    margin-bottom: 32px;
  }
  .cn-redactie h1,
  .cn-redactie h2 {
    color: var(--on-surface);
  }
  .cn-redactie h2 {
    font-size: 24px;
    font-weight: 800;
    margin: 40px 0 12px;
  }
  .cn-redactie p,
  .cn-redactie li {
    font-size: 16px;
    line-height: 1.7;
    color: var(--on-surface-variant);
  }
  .cn-redactie ul {
    padding-left: 20px;
    margin: 12px 0;
  }
  .cn-redactie a {
    color: var(--primary, #7aa2ff);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cn-redactie__updated {
    margin-top: 48px;
    font-size: 13px;
    color: var(--on-surface-variant);
    border-top: 1px solid color-mix(in srgb, var(--on-surface-variant) 25%, transparent);
    padding-top: 16px;
  }
</style>
