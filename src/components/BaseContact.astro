---
<section class="section-contact-form background-color-gradient-blue1" id="contact">
    <div class="page-padding">
        <div class="container-medium">
            <div class="padding-vertical padding-xxlarge">
                <h2>Contacteer ons!</h2>
                <div class="margin-top margin-large">
                    <div class="form-wrapper-2 w-form">
                        <form action="https://n8n.cinematen.be/webhook/cinematen-contact-form" id="email-form" method="post" name="email-form" aria-label="Form"
                            >
                            <div class="form-field-wrapper"><input class="form-input-2 w-input" maxlength="256"
                                    name="Naam" data-name="Naam" placeholder="Naam" type="text" id="Naam"
                                    required="" /></div>
                            <div class="form-field-wrapper"><input class="form-input-2 w-input" maxlength="256"
                                    name="Email" data-name="Email" placeholder="Email" type="email" id="Email"
                                    required="" /></div>
                            <div class="form-field-wrapper"><textarea id="Message" name="Message"
                                    maxlength="5000" data-name="Message"
                                    placeholder="Je boodschap, vraag, compliment, suggestie, feedback, e.d..."
                                    class="form-input-2 is-text-area w-input"></textarea></div>
                            <div class="margin-top margin-small"><input type="submit" data-wait="Please wait..."
                                    class="button-2 is-form-submit w-button" value="Verzend" /></div>
                        </form>
                        <div class="form-success" hidden tabindex="-1">
                            <h3 class="form-success__title">Bedankt voor je bericht!</h3>
                            <p class="form-success__text">Je bericht is verzonden. We nemen zo snel mogelijk contact met je op.</p>
                        </div>
                        <div class="form-error" hidden tabindex="-1">
                            <h3 class="form-error__title">Er ging iets mis</h3>
                            <p class="form-error__text">Je bericht kon niet verzonden worden. Probeer het opnieuw, of mail ons rechtstreeks op <a href="mailto:info@cinematen.be">info@cinematen.be</a>.</p>
                            <input type="button" class="button-2 is-form-submit w-button form-error__retry" value="Probeer opnieuw" />
                        </div>
                        </div>
                    <div class="margin-top margin-large">
                        <a href="mailto:info@cinematen.be" class="button-2 is-form-submit w-button" style="text-decoration: none; display: block; text-align: center; width: 33%; margin-left: auto; margin-right: auto;">Of mail ons!</a>
                    </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
  (() => {
    const form = document.getElementById("email-form");
    if (!(form instanceof HTMLFormElement)) return;

    const wrapper = form.closest(".form-wrapper-2");
    const successView = wrapper?.querySelector(".form-success");
    const errorView = wrapper?.querySelector(".form-error");
    const retryBtn = errorView?.querySelector(".form-error__retry");
    const submitBtn = form.querySelector('input[type="submit"]');

    // --- Rate limit (client-side): 1 verzending per minuut, overleeft refresh ---
    const RATE_LIMIT_MS = 60 * 1000;
    const RATE_LIMIT_KEY = "cn-contact-last-submit";

    const setSubmitEnabled = (enabled: boolean) => {
      if (submitBtn instanceof HTMLInputElement) {
        submitBtn.disabled = !enabled;
        if (enabled) submitBtn.value = "Verzend";
      }
    };

    const applyCooldown = () => {
      const last = Number(localStorage.getItem(RATE_LIMIT_KEY) ?? 0);
      const remaining = last + RATE_LIMIT_MS - Date.now();
      if (remaining <= 0) return;
      setSubmitEnabled(false);
      if (submitBtn instanceof HTMLInputElement) {
        submitBtn.value = `Even wachten (${Math.ceil(remaining / 1000)}s)…`;
      }
      setTimeout(() => {
        setSubmitEnabled(true);
      }, remaining);
    };
    applyCooldown();

    const show = (el) => {
      if (el instanceof HTMLElement) el.hidden = false;
    };
    const hide = (el) => {
      if (el instanceof HTMLElement) el.hidden = true;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      setSubmitEnabled(false);
      if (submitBtn instanceof HTMLInputElement) {
        submitBtn.value = "Verzenden…";
      }

      try {
        const body = new FormData(form);
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(body as unknown as Record<string, string>),
        });
        const data = await response.json().catch(() => ({} as { success?: boolean }));
        if (response.ok && data.success) {
          localStorage.setItem(RATE_LIMIT_KEY, String(Date.now()));
          hide(form);
          hide(errorView);
          show(successView);
          if (successView instanceof HTMLElement) successView.focus();
          return; // cooldown is al actief na succesvolle verzending
        } else {
          hide(form);
          show(errorView);
          if (errorView instanceof HTMLElement) errorView.focus();
        }
      } catch {
        hide(form);
        show(errorView);
        if (errorView instanceof HTMLElement) errorView.focus();
      } finally {
        // Bij mislukken (netwerkfout of 429 rate limit): knop direct terug actief,
        // zodat de gebruiker opnieuw kan proberen
        setSubmitEnabled(true);
      }
    });

    retryBtn?.addEventListener("click", () => {
      hide(errorView);
      show(form);
      const first = form.querySelector<HTMLElement>("#Naam");
      first?.focus();
    });
  })();
</script>
